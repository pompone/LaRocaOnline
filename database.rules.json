{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      "larocaonline": {
        ".read": true,
        "$uid": {
          "$session": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['since'])",
            "since": {
              ".validate": "newData.isNumber() && newData.val() >= now - 60000 && newData.val() <= now"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
